rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Allow any signed-in user to bump like/comment counters on community posts
    function onlyCounterFieldsChanged() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['likes'])
          || changed.hasOnly(['commentsCount'])
          || changed.hasOnly(['likes', 'commentsCount']);
    }

    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(userId);
    }

    match /tryon_results/{docId} {
      allow create: if isOwner(request.resource.data.userId);
      allow read, delete: if isOwner(resource.data.userId);
    }

    match /wishlist/{docId} {
      allow create: if isOwner(request.resource.data.userId);
      allow read, delete: if isOwner(resource.data.userId);
    }

    match /community_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isSignedIn() && (
        isOwner(resource.data.userId) ||
        onlyCounterFieldsChanged()
      );
      allow delete: if isOwner(resource.data.userId);

      // Like subcollection — doc id MUST be the liker's uid
      match /likes/{likeUserId} {
        allow read: if isSignedIn();
        allow create: if isOwner(likeUserId)
          && request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(likeUserId);
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isOwner(request.resource.data.userId)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow delete: if isOwner(resource.data.userId);
      }
    }

    match /aura_leaderboard/{docId} {
      allow read: if isSignedIn();
      allow write: if isOwner(docId);
    }

    match /daily_picks/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Reviews — anyone can read approved reviews, signed-in users can submit once
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 10
        && request.resource.data.body.size() <= 300;
      allow update, delete: if false;
    }

    // Collection group rule to allow querying all 'likes' collections at once
    match /{path=**}/likes/{likeUserId} {
      allow read: if isSignedIn();
      allow create: if isOwner(likeUserId)
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(likeUserId);
    }
  }
}
