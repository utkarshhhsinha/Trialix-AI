rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /base-photos/{imageName} {
      allow read: if true;
      allow write: if request.auth != null && imageName == request.auth.uid + '.jpg';
    }
    match /generations/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /daily_picks/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /tryon-results/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /community-posts/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
