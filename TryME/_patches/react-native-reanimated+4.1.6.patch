--- /dev/null
+++ b/node_modules/react-native-reanimated/android/build/prefab-headers/reanimated/reanimated/CSS/utils/algorithms.h
@@ -0,0 +1,21 @@
+#pragma once
+
+#include <vector>
+#include <algorithm>
+#include <cstddef>
+
+namespace reanimated::css {
+
+template <typename T>
+std::size_t firstSmallerOrEqual(double x, const std::vector<T> &vec) {
+  if (vec.empty()) {
+    return 0;
+  }
+  auto it = std::upper_bound(vec.begin(), vec.end(), x);
+  if (it == vec.begin()) {
+    return 0;
+  }
+  return std::distance(vec.begin(), it) - 1;
+}
+
+} // namespace reanimated::css
