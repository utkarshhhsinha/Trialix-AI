{
  "expo": {
    "name": "Trialix AI",
    "slug": "tryme",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tryme",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aura.virtualtrialroom",
      "buildNumber": "2"
    },
    "android": {
      "package": "com.aura.virtualtrialroom",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FE3C72",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "versionCode": 2
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "kotlinVersion": "2.1.20",
            "ndkVersion": "25.1.8937393",
            "newArchEnabled": true,
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so"
              ]
            }
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-asset",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Trialix AI to access your photos.",
          "savePhotosPermission": "Allow Trialix AI to save photos to your library."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "70e57dac-654a-46f6-8ac7-1af7e4bee87c"
      }
    },
    "owner": "ascendras-organization",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/70e57dac-654a-46f6-8ac7-1af7e4bee87c"
    }
  }
}